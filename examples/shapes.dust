use std::f64::consts::PI

enum Shape
  Circle(f64)
  Rect(f64, f64)
  Triangle(f64, f64)

fn area(shape: Shape) -> f64
  match shape
    Circle(radius)         -> PI * radius ** 2
    Rect(width, height)    -> width * height
    Triangle(base, height) -> 0.5 * base * height

fn describe(shape: Shape) -> str
  match shape
    Circle(radius)         -> "circle with radius {radius}"
    Rect(width, height)    -> "rectangle {width}x{height}"
    Triangle(base, height) -> "triangle base={base} height={height}"

fn main()
  let shapes = vec![Shape::Circle(3.0), Shape::Rect(4.0, 5.0), Shape::Triangle(6.0, 8.0)]
  for shape in shapes
    let area = area(shape)
    println!("{describe(shape)}: area = {area:.2}")
