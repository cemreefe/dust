use std::io
use std::io::BufRead

struct Stack
  values: Vec<f64>

  fn push(self, n: f64)
    self.values.push(n)

  fn pop(self) -> Option<f64>
    self.values.pop()

  fn apply(self, op: str) -> bool
    let rhs = match self.pop()
      Some(val) -> val
      None -> return false

    let lhs = match self.pop()
      Some(val) -> val
      None -> return false

    let result = match op
      "+" -> lhs + rhs
      "-" -> lhs - rhs
      "*" -> lhs * rhs
      "/" -> lhs / rhs
      "%" -> lhs % rhs
      _   -> return false

    self.push(result)
    true

  fn peek(self) -> Option<f64>
    self.values.last().copied()

fn eval(line: str) -> str
  mut stack = Stack()
  for token in line.split_whitespace()
    match token.parse::<f64>()
      Ok(num) -> stack.push(num)
      Err(_) ->
        if !stack.apply(token)
          return "error: invalid token or not enough operands"

  match stack.peek()
    Some(result) -> result.to_string()
    None -> "error: empty expression"

fn main()
  println!("Dust RPN calculator. Examples:  3 4 +   |   2 3 4 * +   |   10 2 /")
  println!("Press Ctrl+C to exit.")
  let stdin = io::stdin()
  for line in stdin.lock().lines()
    let line = line.unwrap!
    let line = line.trim()
    if line.is_empty()
      continue
    println!("= {eval(line)}")
